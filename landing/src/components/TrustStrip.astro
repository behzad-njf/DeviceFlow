---
import { trustItems } from '../data/content';
---

<section class="trust" aria-label="Product highlights">
  <div class="wrap">
    <ul class="trust__list">
      {
        trustItems.map((item) => (
          <li class="trust__item">{item}</li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trust {
    padding-block: 0.75rem 1.5rem;
  }

  .trust__list {
    list-style: none;
    margin: 0;
    padding: 0.85rem 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem 1.35rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(15, 118, 110, 0.12);
  }

  .trust__item {
    font-size: 0.92rem;
    font-weight: 650;
    color: var(--slate-600);
  }

  .trust__item:not(:last-child)::after {
    content: '·';
    margin-left: 1.35rem;
    color: var(--slate-400);
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .trust__list {
      border-radius: var(--radius-md);
      justify-content: flex-start;
    }

    .trust__item:not(:last-child)::after {
      display: none;
    }
  }
</style>
