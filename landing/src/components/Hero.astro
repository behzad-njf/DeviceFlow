---
import MessagePath from './illustrations/MessagePath.astro';
import { GITHUB_URL } from '../consts';
---

<section class="hero" id="top" aria-labelledby="hero-brand">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow">Open-source · Self-hosted · Apache 2.0</p>
      <h1 id="hero-brand" class="hero__brand">DeviceFlow</h1>
      <p class="hero__headline">
        Turn Android phones into an API-driven SMS gateway
      </p>
      <p class="hero__support">
        Pair real devices with a Django API and React dashboard. Send OTP, transactional SMS, and USSD—on SIMs you control.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={GITHUB_URL} rel="noopener noreferrer">View on GitHub</a>
        <a class="btn btn--ghost" href="#guide">Get started</a>
      </div>
    </div>
    <div class="hero__visual" aria-hidden="false">
      <MessagePath />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .hero__eyebrow {
    margin: 0 0 0.85rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--teal-600);
    animation: hero-enter 500ms var(--ease-out) both;
  }

  .hero__brand {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5.25rem);
    font-weight: 780;
    letter-spacing: -0.045em;
    line-height: 0.95;
    color: var(--slate-900);
    animation: hero-enter 560ms var(--ease-out) 60ms both;
  }

  .hero__headline {
    margin: 1rem 0 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.25;
    color: var(--teal-700);
    animation: hero-enter 600ms var(--ease-out) 120ms both;
  }

  .hero__support {
    margin: 1rem 0 0;
    max-width: 34rem;
    color: var(--slate-600);
    font-size: 1.08rem;
    animation: hero-enter 640ms var(--ease-out) 160ms both;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.65rem;
    animation: hero-enter 680ms var(--ease-out) 200ms both;
  }

  .hero__visual {
    animation: hero-enter 720ms var(--ease-out) 180ms both;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__headline {
      max-width: none;
    }

    .hero__visual {
      order: -1;
      max-width: 520px;
      margin-inline: auto;
    }
  }
</style>
