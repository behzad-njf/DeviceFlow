---
interface Props {
  art: 'docker' | 'pair' | 'project' | 'send' | 'monitor';
}

const { art } = Astro.props;

const labels = {
  docker: 'Containers for API and dashboard',
  pair: 'Pairing code bridging phone and cloud',
  project: 'Device attached to project with API key',
  send: 'Backend sending OTP via API',
  monitor: 'Live monitor dashboard tiles',
} as const;
---

<svg class="guide-art" viewBox="0 0 160 110" role="img" aria-label={labels[art]} xmlns="http://www.w3.org/2000/svg">
  <rect width="160" height="110" rx="14" fill="#F0FDFA" />
  {
    art === 'docker' && (
      <g fill="none" stroke-linecap="round">
        <rect x="24" y="28" width="48" height="54" rx="8" fill="#fff" stroke="#0F766E" stroke-width="2" />
        <rect x="32" y="38" width="32" height="8" rx="2" fill="#0F766E" />
        <rect x="32" y="52" width="32" height="8" rx="2" fill="#CCFBF1" />
        <rect x="32" y="66" width="32" height="8" rx="2" fill="#CCFBF1" />
        <rect x="88" y="28" width="48" height="54" rx="8" fill="#0D5C56" />
        <rect x="96" y="40" width="32" height="6" rx="2" fill="#fff" opacity="0.9" />
        <rect x="96" y="52" width="24" height="6" rx="2" fill="#CCFBF1" />
        <rect x="96" y="64" width="28" height="6" rx="2" fill="#CCFBF1" />
      </g>
    )
  }
  {
    art === 'pair' && (
      <g fill="none" stroke-linecap="round">
        <rect x="22" y="22" width="40" height="68" rx="8" fill="#fff" stroke="#0F766E" stroke-width="2" />
        <circle cx="42" cy="78" r="3" fill="#0F766E" />
        <rect x="70" y="40" width="50" height="28" rx="8" fill="#0F766E" />
        <text x="95" y="58" text-anchor="middle" fill="#fff" font-size="11" font-family="ui-monospace,monospace" font-weight="700">
          7K2M
        </text>
        <path d="M62 54h8" stroke="#D9776A" stroke-width="2.5" />
      </g>
    )
  }
  {
    art === 'project' && (
      <g fill="none" stroke-linecap="round">
        <rect x="20" y="30" width="50" height="50" rx="10" fill="#fff" stroke="#0F766E" stroke-width="2" />
        <circle cx="45" cy="48" r="8" fill="#CCFBF1" stroke="#0F766E" stroke-width="2" />
        <path d="M34 68c3-8 19-8 22 0" stroke="#0F766E" stroke-width="2" />
        <path d="M70 55h14" stroke="#0F766E" stroke-width="2" stroke-dasharray="3 3" />
        <rect x="84" y="36" width="56" height="40" rx="10" fill="#0D5C56" />
        <text x="112" y="60" text-anchor="middle" fill="#fff" font-size="10" font-family="ui-monospace,monospace" font-weight="700">
          pk_live
        </text>
      </g>
    )
  }
  {
    art === 'send' && (
      <g fill="none" stroke-linecap="round">
        <rect x="18" y="34" width="58" height="44" rx="8" fill="#0F172A" />
        <text x="47" y="60" text-anchor="middle" fill="#5EEAD4" font-size="9" font-family="ui-monospace,monospace">
          mode:otp
        </text>
        <path d="M82 56h18" stroke="#0F766E" stroke-width="2.5" />
        <polygon points="100,50 112,56 100,62" fill="#D9776A" />
        <rect x="116" y="28" width="28" height="52" rx="6" fill="#fff" stroke="#0F766E" stroke-width="2" />
        <rect x="122" y="36" width="16" height="12" rx="2" fill="#CCFBF1" />
      </g>
    )
  }
  {
    art === 'monitor' && (
      <g fill="none" stroke-linecap="round">
        <rect x="20" y="24" width="120" height="66" rx="10" fill="#fff" stroke="#0F766E" stroke-width="2" />
        <rect x="32" y="38" width="28" height="36" rx="5" fill="#F0FDFA" stroke="#0F766E" stroke-width="1.5" />
        <rect x="66" y="38" width="28" height="36" rx="5" fill="#F0FDFA" stroke="#0F766E" stroke-width="1.5" />
        <rect x="100" y="38" width="28" height="36" rx="5" fill="#F0FDFA" stroke="#0F766E" stroke-width="1.5" />
        <circle cx="40" cy="48" r="3" fill="#059669" />
        <circle cx="74" cy="48" r="3" fill="#059669" />
        <circle cx="108" cy="48" r="3" fill="#D9776A" />
      </g>
    )
  }
</svg>

<style>
  .guide-art {
    width: 100%;
    max-width: 160px;
    height: auto;
  }
</style>
