---
/**
 * Signature motion: phones → API → SMS path.
 * CSS-animated dots along SVG paths; paused via IntersectionObserver when offscreen.
 */
---

<figure class="msg-path" data-msg-path aria-label="Illustration of Android phones connecting to a REST API that delivers OTP SMS">
  <svg viewBox="0 0 560 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
    <defs>
      <linearGradient id="apiGrad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#14837A" />
        <stop offset="100%" stop-color="#0D5C56" />
      </linearGradient>
      <filter id="soft" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#0D5C56" flood-opacity="0.12" />
      </filter>
      <path id="p1" d="M110 250 C160 210, 200 180, 280 170" />
      <path id="p2" d="M150 95 C200 120, 230 145, 280 170" />
      <path id="p3" d="M90 150 C150 150, 210 160, 280 170" />
      <path id="pOut" d="M340 170 C400 160, 450 140, 500 110" />
    </defs>

    <rect width="560" height="360" rx="28" fill="#F0FDFA" />
    <circle cx="480" cy="60" r="50" fill="#CCFBF1" opacity="0.55" />
    <circle cx="70" cy="300" r="40" fill="#CCFBF1" opacity="0.4" />

    <!-- Phone A -->
    <g filter="url(#soft)">
      <rect x="58" y="200" width="64" height="110" rx="12" fill="#fff" stroke="#0F766E" stroke-width="3" />
      <rect x="70" y="216" width="40" height="60" rx="6" fill="#CCFBF1" />
      <circle cx="90" cy="292" r="5" fill="#0F766E" />
      <path d="M78 230h24M78 242h16" stroke="#0F766E" stroke-width="2" stroke-linecap="round" opacity="0.5" />
    </g>

    <!-- Phone B -->
    <g filter="url(#soft)">
      <rect x="118" y="48" width="58" height="100" rx="11" fill="#fff" stroke="#0F766E" stroke-width="3" />
      <rect x="128" y="62" width="38" height="52" rx="5" fill="#F0FDFA" />
      <circle cx="147" cy="132" r="4.5" fill="#0F766E" />
    </g>

    <!-- Phone C -->
    <g filter="url(#soft)">
      <rect x="36" y="88" width="52" height="90" rx="10" fill="#fff" stroke="#0D5C56" stroke-width="2.5" />
      <rect x="44" y="100" width="36" height="48" rx="5" fill="#CCFBF1" />
      <circle cx="62" cy="162" r="4" fill="#0D5C56" />
    </g>

    <!-- Paths -->
    <g fill="none" stroke="#0F766E" stroke-width="2.5" stroke-linecap="round" opacity="0.35">
      <use href="#p1" />
      <use href="#p2" />
      <use href="#p3" />
      <use href="#pOut" />
    </g>

    <!-- Animated dots -->
    <circle class="path-dot path-dot--1" r="5" fill="#D9776A">
      <animateMotion dur="3.2s" repeatCount="indefinite" begin="0s">
        <mpath href="#p1" />
      </animateMotion>
    </circle>
    <circle class="path-dot path-dot--2" r="4.5" fill="#0F766E">
      <animateMotion dur="3.6s" repeatCount="indefinite" begin="0.6s">
        <mpath href="#p2" />
      </animateMotion>
    </circle>
    <circle class="path-dot path-dot--3" r="4" fill="#14837A">
      <animateMotion dur="4s" repeatCount="indefinite" begin="1.1s">
        <mpath href="#p3" />
      </animateMotion>
    </circle>
    <circle class="path-dot path-dot--4" r="5" fill="#D9776A">
      <animateMotion dur="2.8s" repeatCount="indefinite" begin="0.3s">
        <mpath href="#pOut" />
      </animateMotion>
    </circle>

    <!-- API hub -->
    <g filter="url(#soft)">
      <rect x="248" y="128" width="96" height="84" rx="18" fill="url(#apiGrad)" />
      <text x="296" y="160" text-anchor="middle" fill="#fff" font-size="13" font-family="Syne, ui-sans-serif, sans-serif" font-weight="700">
        REST API
      </text>
      <text x="296" y="182" text-anchor="middle" fill="#CCFBF1" font-size="11" font-family="ui-monospace, monospace">
        {'{ JSON }'}
      </text>
    </g>

    <!-- OTP bubble -->
    <g filter="url(#soft)">
      <rect x="455" y="72" width="78" height="52" rx="14" fill="#fff" stroke="#0F766E" stroke-width="2.5" />
      <path d="M470 124l8-10h12" fill="#fff" stroke="#0F766E" stroke-width="2.5" stroke-linejoin="round" />
      <text x="494" y="96" text-anchor="middle" fill="#0D5C56" font-size="11" font-family="ui-sans-serif,sans-serif" font-weight="700">
        OTP SMS
      </text>
      <text x="494" y="112" text-anchor="middle" fill="#64748B" font-size="12" font-family="ui-monospace,monospace" font-weight="700">
        482915
      </text>
    </g>

    <!-- curl chip -->
    <g>
      <rect x="360" y="230" width="120" height="36" rx="10" fill="#0F172A" />
      <text x="420" y="253" text-anchor="middle" fill="#5EEAD4" font-size="12" font-family="ui-monospace,monospace">
        $ curl /sms/
      </text>
    </g>
  </svg>
  <figcaption class="sr-only">
    Phones send traffic to a REST API which delivers OTP SMS to users.
  </figcaption>
</figure>

<style>
  .msg-path {
    margin: 0;
    width: 100%;
  }

  .msg-path svg {
    width: 100%;
    height: auto;
  }

  .msg-path.is-paused .path-dot animateMotion,
  .msg-path.is-paused .path-dot {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .path-dot {
      display: none;
    }
  }
</style>

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-msg-path]');
  if (roots.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const svg = entry.target.querySelector('svg');
          if (!svg) continue;
          entry.target.classList.toggle('is-paused', !entry.isIntersecting);
          if (entry.isIntersecting) {
            svg.unpauseAnimations();
          } else {
            svg.pauseAnimations();
          }
        }
      },
      { threshold: 0.15 },
    );
    roots.forEach((el) => io.observe(el));
  }
</script>
