# Copy to keystore.properties and fill in real values.
# NEVER commit keystore.properties or *.jks / *.keystore files.
#
# Generate a keystore (once):
#   mkdir -p keystore
#   keytool -genkeypair -v \
#     -keystore keystore/deviceflow-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias deviceflow
#
# Then set paths relative to android-agent/ (this file's directory).

storeFile=keystore/deviceflow-release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=deviceflow
keyPassword=CHANGE_ME_KEY_PASSWORD
