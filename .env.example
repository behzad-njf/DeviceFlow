# DeviceFlow environment example — copy to `.env` at repo root.
# Never commit real secrets.

SECRET_KEY=dev-insecure-change-me-deviceflow
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Leave DATABASE_URL unset for local SQLite (backend/db.sqlite3).
# Docker Compose sets Postgres automatically.
# DATABASE_URL=postgres://deviceflow:deviceflow@localhost:5432/deviceflow

REDIS_URL=redis://localhost:6379/0

# Access token lifetime (minutes). Dashboard refreshes automatically.
JWT_ACCESS_MINUTES=720
# Refresh token lifetime (days). Logout when this expires.
JWT_REFRESH_DAYS=30

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dashboard (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Mark devices offline after this many seconds without heartbeat (Celery beat).
DEVICE_OFFLINE_AFTER_SECONDS=45
